      "obligation": "conditional",
      "term_uri": "https://www.w3id.org/conservation/terms/metadata/GB6DF3"
    },
    {
      "local_name": "objektbeschreibung.objekttyp",
      "label": "The type or category of object.",
      "obligation": "mandatory",
      "repeatable": false,
      "term_uri": "https://www.w3id.org/conservation/terms/metadata/F1BA31"
