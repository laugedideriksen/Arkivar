{
  "_comment": "The subset of the Nepomuk File Ontology (NFO) that Arkivar's FIELD_REGISTRY currently extracts -- structural/format facts about a file's content.",
  "id": "nfo",
  "prefix": "nfo",
  "namespace_uri": "http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#",
  "terms": [
    {
      "local_name": "width",
      "label": "The pixel width of an image or video.",
      "obligation": "optional",
      "repeatable": false
    },
    {
      "local_name": "height",
      "label": "The pixel height of an image or video.",
      "obligation": "optional",
      "repeatable": false
    },
    {
      "local_name": "colorDepth",
      "label": "The number of bits used per color channel.",
      "obligation": "optional",
      "repeatable": false
    },
    {
      "local_name": "duration",
      "label": "The playback duration of an audio or video file.",
      "obligation": "optional",
      "repeatable": false
    },
    {
      "local_name": "sampleRate",
      "label": "The audio sample rate, in Hz.",
      "obligation": "optional",
      "repeatable": false
    },
    {
      "local_name": "channels",
      "label": "The number of audio channels.",
      "obligation": "optional",
      "repeatable": false
    },
    {
      "local_name": "pageCount",
      "label": "The number of pages in a document.",
      "obligation": "optional",
      "repeatable": false
    },
    {
      "local_name": "wordCount",
      "label": "The number of words in a document's text content.",
      "obligation": "optional",
      "repeatable": false
    },
    {
      "local_name": "characterCount",
      "label": "The number of characters in a document's text content.",
      "obligation": "optional",
      "repeatable": false
    }
  ],
  "events": []
}
